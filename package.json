{
  "name": "visora-cli",
  "version": "0.1.0",
  "description": "Connect your local dev site to Visora and test, before launch, whether it will be visible to AI search engines.",
  "type": "commonjs",
  "bin": {
    "visora": "./bin/visora.js"
  },
  "main": "index.js",
  "keywords": ["geo", "ai-visibility", "seo", "llms-txt", "hong-kong", "generative-engine-optimization", "ai-search"],
  "homepage": "https://visoraco.com",
  "bugs": "https://github.com/Visora-Co/visora-cli/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Visora-Co/visora-cli.git"
  },
  "scripts": {
    "test": "vitest run",
    "build:binaries": "pkg . --targets node20-win-x64,node20-macos-x64,node20-macos-arm64,node20-linux-x64 --output ./dist/bin --compress GZip"
  },
  "pkg": {
    "scripts": ["commands/**/*.js", "lib/**/*.js"],
    "assets": [],
    "outputPath": "./dist"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@yao-pkg/pkg": "^6.20.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "into-stream": "6"
  }
}
